PORT=3000
DATABASE_PATH=./data/hrm.sqlite
# Development: leave empty to use the request origin; local Vite :5173 is allowed.
# Production: set the exact public origin, e.g. https://hrm.example.com
APP_ORIGIN=
# Set a random 32-byte hex key. Generate: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
NODE_ENV=development
